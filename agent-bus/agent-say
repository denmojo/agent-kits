#!/usr/bin/python3 -I
"""agent-say: post a message to the bus as $AGENT_NAME."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import agentbus

name = os.environ.get("AGENT_NAME", "")
if not name or name == agentbus.human():
    print("agent-say: AGENT_NAME must be set to an agent name (not the person's)", file=sys.stderr)
    sys.exit(2)
sys.exit(agentbus.cli_say(name, sys.argv[1:], "agent-say"))
